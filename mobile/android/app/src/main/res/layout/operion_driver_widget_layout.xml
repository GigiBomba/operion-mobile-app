<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 5A — "Next stop / active trip" AppWidget layout (driver role). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_driver_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_driver_title"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_active_trip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_no_active_trip"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_next_stop_label"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_next_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_value_unavailable"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
